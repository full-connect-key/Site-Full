# ------------------------------------------------------------------
# Full Connect Key — variáveis de ambiente (copie para .env)
# Nunca commite o arquivo .env. Nenhum valor real deve ir para o git.
# ------------------------------------------------------------------

# Banco PostgreSQL (docker compose sobe em 127.0.0.1:5432)
DATABASE_URL=postgresql://fck:fck_dev@127.0.0.1:5432/fck
# Banco separado para testes de integração e e2e (fixtures nunca vão para o banco de revisão)
DATABASE_URL_TEST=postgresql://fck:fck_dev@127.0.0.1:5432/fck_test

# Segredo do Payload (gere com: openssl rand -hex 32)
PAYLOAD_SECRET=

# URL pública do site (sem barra no final). Usada em SEO, sitemap e preview.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Ambiente: development | staging | production
# Em qualquer valor diferente de "production" o site responde com noindex.
SITE_ENV=development

# Primeiro usuário admin — criado automaticamente na primeira inicialização
# se ainda não existir nenhum usuário. Apague a senha do .env depois do primeiro login.
PAYLOAD_INITIAL_ADMIN_EMAIL=
PAYLOAD_INITIAL_ADMIN_PASSWORD=

# Segredo usado pelo preview autenticado (gere com: openssl rand -hex 16)
PREVIEW_SECRET=

# E-mail (desenvolvimento: Mailpit do docker compose em 127.0.0.1:1025)
# Em staging/produção só configure SMTP real após aprovação e credenciais.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Full Connect Key

# Armazenamento de mídia: "local" (padrão). S3 apenas com conta autorizada.
MEDIA_STORAGE=local
