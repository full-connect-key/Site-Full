# Full Connect Key — site em PHP (Hostinger / Apache / LiteSpeed)
Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # www → sem www (ex.: www.fullconnectkey.com.br → fullconnectkey.com.br),
  # direto para https e mantendo caminho e parâmetros, num único 301.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301,NE]

  # HTTPS (ativo só quando o site já responde em https)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Bloqueia código, configuração, documentação e ferramentas de desenvolvimento.
  RewriteRule ^(app|storage|docs|tests|scripts|node_modules|\.git|\.github)(/|$) - [F,L]
  RewriteRule (^|/)\. - [F,L]
  RewriteRule \.(md|sql|sh|lock|log|dist|sample)$ - [F,L,NC]
  RewriteRule ^(package(-lock)?\.json|playwright\.config\.js|composer\.(json|lock)|docker-compose\.yml)$ - [F,L,NC]

  # Arquivos reais (assets, uploads) são servidos direto; o resto vai para o index.php.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]
  RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(css|woff2|svg|webp|jpg|jpeg|png|avif|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Módulos JS são importados sem ?v= (import dinâmico/estático entre módulos):
  # o navegador revalida a cada visita (304 barato) e nunca fica com JS antigo após um deploy.
  <FilesMatch "\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>
