# Full Connect Key — site em PHP (Hostinger / Apache / LiteSpeed)
Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS (ativo só quando o site já responde em https)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Bloqueia código, configuração, documentação e ferramentas de desenvolvimento.
  RewriteRule ^(app|storage|docs|tests|scripts|node_modules|\.git|\.github)(/|$) - [F,L]
  RewriteRule (^|/)\. - [F,L]
  RewriteRule \.(md|sql|sh|lock|log|dist|sample)$ - [F,L,NC]
  RewriteRule ^(package(-lock)?\.json|playwright\.config\.js|composer\.(json|lock)|docker-compose\.yml)$ - [F,L,NC]

  # Arquivos reais (assets, uploads) são servidos direto; o resto vai para o index.php.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]
  RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(css|js|woff2|svg|webp|jpg|jpeg|png|avif|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>
